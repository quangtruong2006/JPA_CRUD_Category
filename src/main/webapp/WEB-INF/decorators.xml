<?xml version="1.0" encoding="UTF-8"?>
<decorators defaultdir="/decorators">
    <decorator name="none" path="/login">
        <pattern>/login*</pattern>
        <pattern>/register*</pattern>
    </decorator>

    <!-- CHỈ trang trí cho web chung, bỏ qua toàn bộ admin để nhường quyền cho MySiteMeshFilter -->
    <decorator name="web" path="web.jsp">
        <pattern>/*</pattern>
        <exclude>/admin/*</exclude>
        <exclude>/decorators/*</exclude>
    </decorator>
</decorators>